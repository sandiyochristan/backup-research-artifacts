<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vrp.lowsdk">

    <!-- ZERO permissions declared. targetSdkVersion deliberately set below 31 to test
         whether ServiceStateProvider's ENFORCE_LOCATION_PERMISSION_CHECK compat-change
         gate (which only applies when the CALLING app's targetSdk >= 31) can be bypassed
         simply by declaring a low targetSdkVersion. -->
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <activity
            android:name="com.vrp.lowsdk.ServiceStateLeakActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
